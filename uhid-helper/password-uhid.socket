# The socket of the password-java desktop app's security key helper: every connection starts a password-uhid@.service
# that creates one security key until the connection ends. Whoever can connect can create such a device, and it is
# given to whoever is at the seat, so only the members of a dedicated group may.
[Unit]
Description=password-java security key helper

[Socket]
ListenStream=/run/password-uhid.sock
Accept=yes
SocketMode=0660
SocketGroup=password-uhid
MaxConnections=16
# per user, so that one can't use up all of them
MaxConnectionsPerSource=4

[Install]
WantedBy=sockets.target
