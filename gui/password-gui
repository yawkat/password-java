#!/bin/sh
# Launcher for the password manager GUI. Uses the system Qt 6 libraries; the QtJambi version in gui/pom.xml must
# match the installed Qt minor version.
set -e
JAR="${PASSWORD_GUI_JAR:-$(dirname "$(readlink -f "$0")")/target/gui-1.0-SNAPSHOT-shaded.jar}"
exec java --enable-native-access=ALL-UNNAMED -Djava.library.path=/usr/lib -jar "$JAR" "$@"
