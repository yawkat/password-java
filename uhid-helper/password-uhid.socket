# The socket of the password-java desktop app's security key helper: every connection starts a password-uhid@.service
# that creates one security key until the connection ends. Whoever can connect can create such a device, so only the
# group of desktop users may.
[Unit]
Description=password-java security key helper

[Socket]
ListenStream=/run/password-uhid.sock
Accept=yes
SocketMode=0660
SocketGroup=users
MaxConnections=16

[Install]
WantedBy=sockets.target
