[Unit]
Description=password-java security key helper
# instances end with an error when the client misbehaves; don't keep them around
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/local/bin/password-uhid
StandardInput=socket
StandardOutput=socket
StandardError=journal

# root only to open /dev/uhid, which belongs to root; no capabilities, and nothing else to see
User=root
CapabilityBoundingSet=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
