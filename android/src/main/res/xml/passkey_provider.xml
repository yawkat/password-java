<?xml version="1.0" encoding="utf-8"?>
<!-- The credential types of PasskeyProviderService: passkeys only, the passwords are free text. The names are the
     androidx ones (PublicKeyCredential.TYPE_PUBLIC_KEY_CREDENTIAL): the credential manager skips the provider for a
     type it doesn't list. -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
